{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sqlite": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "{env:SQLITE_DB_PATH}"
      ],
      "environment": {
        "SQLITE_DB_PATH": "{env:SQLITE_DB_PATH}"
      }
    }
  }
}