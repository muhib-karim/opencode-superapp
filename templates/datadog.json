{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "datadog": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/v2/mcp",
      "headers": {
        "DD-API-KEY": "{env:DD_API_KEY}",
        "DD-APPLICATION-KEY": "{env:DD_APP_KEY}"
      },
      "oauth": false
    }
  }
}