{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "datadog": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp",
      "headers": {
        "DD_API_KEY": "{env:DD_API_KEY}",
        "DD_APPLICATION_KEY": "{env:DD_APP_KEY}"
      },
      "oauth": false
    }
  }
}