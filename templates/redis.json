{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "redis": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@gongrzhe/server-redis-mcp",
        "redis://localhost:6379"
      ],
      "environment": {
        "REDIS_URL": "{env:REDIS_URL}"
      }
    }
  }
}