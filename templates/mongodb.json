{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mongodb": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mongodb-mcp-server",
        "--connectionString",
        "{env:MONGODB_URI}"
      ],
      "environment": {
        "MONGODB_URI": "{env:MONGODB_URI}"
      }
    }
  }
}