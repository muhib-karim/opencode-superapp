{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "obsidian": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-obsidian",
        "{env:OBSIDIAN_VAULT_PATH}"
      ],
      "environment": {
        "OBSIDIAN_VAULT_PATH": "{env:OBSIDIAN_VAULT_PATH}"
      }
    }
  }
}