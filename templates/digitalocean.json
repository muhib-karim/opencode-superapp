{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "digitalocean": {
      "enabled": true,
      "type": "remote",
      "url": "https://apps.mcp.digitalocean.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:DIGITALOCEAN_API_TOKEN}"
      },
      "oauth": false
    }
  }
}