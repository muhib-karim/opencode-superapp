{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "git": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ]
    },
    "github": {
      "enabled": true,
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "fetch": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "puppeteer": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "chrome-devtools-mcp@latest"
      ]
    },
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {}
    },
    "vercel": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.vercel.com",
      "oauth": {}
    },
    "netlify": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@netlify/mcp"
      ],
      "environment": {
        "NETLIFY_PERSONAL_ACCESS_TOKEN": "{env:NETLIFY_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "shadcn": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "oauth": false
    },
    "gh_grep": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.grep.app",
      "oauth": false
    },
    "supabase": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref={env:SUPABASE_PROJECT_REF}"
      ],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
      }
    }
  }
}