{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:POSTGRES_CONNECTION_STRING}"
      ],
      "environment": {
        "POSTGRES_CONNECTION_STRING": "{env:POSTGRES_CONNECTION_STRING}"
      }
    },
    "sqlite": {
      "enabled": true,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-sqlite",
        "--db-path",
        "{env:SQLITE_DB_PATH}"
      ],
      "environment": {
        "SQLITE_DB_PATH": "{env:SQLITE_DB_PATH}"
      }
    },
    "mysql": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@benborla29/mcp-server-mysql"
      ],
      "environment": {
        "MYSQL_HOST": "{env:MYSQL_HOST}",
        "MYSQL_PORT": "{env:MYSQL_PORT}",
        "MYSQL_USER": "{env:MYSQL_USER}",
        "MYSQL_PASSWORD": "{env:MYSQL_PASSWORD}",
        "MYSQL_DATABASE": "{env:MYSQL_DATABASE}"
      }
    },
    "mongodb": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mongodb-mcp-server",
        "--connectionString",
        "{env:MONGODB_URI}"
      ],
      "environment": {
        "MONGODB_URI": "{env:MONGODB_URI}"
      }
    },
    "redis": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@gongrzhe/server-redis-mcp",
        "redis://localhost:6379"
      ],
      "environment": {
        "REDIS_URL": "{env:REDIS_URL}"
      }
    },
    "supabase": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only",
        "--project-ref={env:SUPABASE_PROJECT_REF}"
      ],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "prisma": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@prisma/mcp-server"
      ],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}"
      }
    },
    "neon": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.neon.tech/sse",
      "headers": {
        "Authorization": "Bearer {env:NEON_API_KEY}"
      },
      "oauth": false
    },
    "sequential-thinking": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    }
  }
}