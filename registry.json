  {
    "id": "postgres",
    "title": "PostgreSQL",
    "description": "Run read-only SQL, inspect schema, explain queries.",
    "type": "local",
    "category": "Data",
    "stacks": [
      "data-analysis"
    ],
    "command": [
      "npx",
      "-y",
      "@modelcontextprotocol/server-postgres",
      "{env:POSTGRES_CONNECTION_STRING}"
    ],
    "environment": {
      "POSTGRES_CONNECTION_STRING": "{env:POSTGRES_CONNECTION_STRING}"
    },
    "envVars": [
      {
        "name": "POSTGRES_CONNECTION_STRING",
        "required": true,
        "desc": "postgresql://user:pass@localhost:5432/db"
      }
