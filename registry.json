      "GITLAB_API_URL": "{env:GITLAB_API_URL}"
    },
    "envVars": [
      {
        "name": "GITLAB_PERSONAL_ACCESS_TOKEN",
        "required": true,
        "desc": "glpat- token"
      },
      {
