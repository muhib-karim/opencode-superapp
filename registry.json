[
  {
    "id": "filesystem",
    "title": "Filesystem",
    "description": "Secure scoped file read/write, search and directory listing. The safest default local MCP.",
    "type": "local",
    "category": "Core",
    "stacks": [
      "web-dev",
      "superapp"
    ],
    "command": [
      "npx",
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "."
    ],
    "environment": {},
    "envVars": [],
    "toolsPrefix": "filesystem_*",
    "install": "npx -y @modelcontextprotocol/server-filesystem"
  },
  {
    "id": "git",
    "title": "Git",
    "description": "Branch, diff, log, status and commit operations on a local repo.",
    "type": "local",
    "category": "Core",
    "stacks": [
      "web-dev"
    ],
    "command": [
      "uvx",
      "mcp-server-git"
    ],
    "environment": {},
    "envVars": [],
    "toolsPrefix": "git_*",
    "install": "uvx mcp-server-git"
  },
  {
    "id": "github",
    "title": "GitHub",
    "description": "Repos, issues, PRs, reviews, CI runs. Highest-token server \u2014 enable per-agent.",
    "type": "local",
    "category": "Dev",
    "stacks": [
      "web-dev",
      "devops"
    ],
    "command": [
      "docker",
      "run",
      "-i",
      "--rm",
      "-e",
      "GITHUB_PERSONAL_ACCESS_TOKEN",
      "ghcr.io/github/github-mcp-server"
    ],
    "environment": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
    },
    "envVars": [
      {
        "name": "GITHUB_PERSONAL_ACCESS_TOKEN",
        "required": true,
        "desc": "ghp_ token with repo scope"
      }
    ],
    "toolsPrefix": "github_*",
    "install": "docker pull ghcr.io/github/github-mcp-server"
  },
  {
    "id": "gitlab",
    "title": "GitLab",
    "description": "Projects, MRs, pipelines and issues for GitLab.com / self-hosted.",
    "type": "local",
    "category": "Dev",
    "stacks": [
      "devops"
    ],
    "command": [
      "npx",
      "-y",
      "@modelcontextprotocol/server-gitlab"
    ],
    "environment": {
