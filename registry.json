    "toolsPrefix": "postgres_*",
    "install": "npx -y @modelcontextprotocol/server-postgres"
  },
  {
    "id": "sqlite",
    "title": "SQLite",
    "description": "Local .sqlite/.db querying without a server. Great for prototypes.",
    "type": "local",
    "category": "Data",
    "stacks": [
      "data-analysis"
    ],
    "command": [
      "uvx",
      "--with",
      "mcp<2",
      "mcp-server-sqlite",
      "--db-path",
      "{env:SQLITE_DB_PATH}"
    ],
    "environment": {
      "SQLITE_DB_PATH": "{env:SQLITE_DB_PATH}"
    },
    "envVars": [
      {
        "name": "SQLITE_DB_PATH",
        "required": true,
        "desc": "Absolute path to .sqlite file"
      }
    ],
    "toolsPrefix": "sqlite_*",
    "install": "uvx --with \"mcp<2\" mcp-server-sqlite"
  },
  {
    "id": "mysql",
    "title": "MySQL / MariaDB",
    "description": "Schema inspection and SELECT queries against MySQL.",
    "type": "local",
    "category": "Data",
    "stacks": [
      "data-analysis"
    ],
    "command": [
      "npx",
      "-y",
      "@benborla29/mcp-server-mysql"
    ],
    "environment": {
      "MYSQL_HOST": "{env:MYSQL_HOST}",
      "MYSQL_PORT": "{env:MYSQL_PORT}",
      "MYSQL_USER": "{env:MYSQL_USER}",
      "MYSQL_PASS": "{env:MYSQL_PASSWORD}",
      "MYSQL_DB": "{env:MYSQL_DATABASE}"
    },
    "envVars": [
      {
        "name": "MYSQL_HOST",
        "required": true,
        "desc": "e.g. 127.0.0.1"
      },
      {
        "name": "MYSQL_USER",
        "required": true,
        "desc": "db user"
      },
      {
        "name": "MYSQL_PASSWORD",
        "required": true,
        "desc": "db password"
      },
      {
        "name": "MYSQL_DATABASE",
        "required": true,
        "desc": "database name"
      },
      {
        "name": "MYSQL_PORT",
        "required": false,
        "desc": "default 3306"
      }
    ],
    "toolsPrefix": "mysql_*",
    "install": "npx -y @benborla29/mcp-server-mysql"
  },
