{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/muhib-karim/opencode-superapp/schema/registry.schema.json",
  "title": "opencode-superapp MCP registry",
  "description": "Shape of registry.json. Checked by scripts/validate.mjs (zero-dependency validator in scripts/lib/schema.mjs). Conditional rules (local => command, remote => url) are enforced in scripts/lib/registry.mjs.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "description", "type", "category", "stacks", "envVars", "toolsPrefix", "install"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "title": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "enum": ["local", "remote"] },
      "category": { "type": "string", "minLength": 1 },
      "stacks": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
      "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "environment": { "type": "object", "additionalProperties": { "type": "string" } },
      "url": { "type": "string", "pattern": "^https://" },
      "headers": { "type": "object", "additionalProperties": { "type": "string" } },
      "oauth": { "type": ["boolean", "object"] },
      "envVars": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "required", "desc"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "required": { "type": "boolean" },
            "desc": { "type": "string" }
          }
        }
      },
      "toolsPrefix": { "type": "string", "minLength": 1 },
      "install": { "type": "string", "minLength": 1 }
    }
  }
}
